# Doxyfile for the Fl_Dock manual, configured by CMake from Doxyfile.in.

PROJECT_NAME           = "Fl_Dock @PROJECT_VERSION@"
OUTPUT_DIRECTORY       = .
OUTPUT_LANGUAGE        = English
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES
TOC_INCLUDE_HEADINGS   = 0
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_PACKAGE        = NO
EXTRACT_STATIC         = NO
EXTRACT_LOCAL_CLASSES  = NO
EXTRACT_LOCAL_METHODS  = NO
INTERNAL_DOCS          = NO
SHOW_INCLUDE_FILES     = YES
SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = YES
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
WARN_FORMAT            = "$file:$line: $text"
WARN_LOGFILE           = @CMAKE_CURRENT_BINARY_DIR@/Doxyfile_error.log
INPUT                  = @CMAKE_CURRENT_SOURCE_DIR@/src/index.dox \
                         @CMAKE_CURRENT_SOURCE_DIR@/src/intro.dox \
                         @CMAKE_CURRENT_SOURCE_DIR@/src/design.dox \
                         @CMAKE_CURRENT_SOURCE_DIR@/src/examples.dox \
                         @PROJECT_SOURCE_DIR@/FL \
                         @PROJECT_SOURCE_DIR@/src
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.H \
                         *.cxx
RECURSIVE              = NO
EXCLUDE                = @PROJECT_SOURCE_DIR@/src/Fl_Dock_Drag.H \
                         @PROJECT_SOURCE_DIR@/src/Fl_Dock_Drag.cxx
EXAMPLE_PATH           = @PROJECT_SOURCE_DIR@/test
EXAMPLE_PATTERNS       = *.cxx
SOURCE_BROWSER         = NO
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = YES
ALPHABETICAL_INDEX     = YES
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
HTML_COLORSTYLE        = TOGGLE
HTML_DYNAMIC_MENUS     = YES
GENERATE_TREEVIEW      = YES
GENERATE_LATEX         = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = FL_DOXYGEN \
                         FL_DOCK_EXPORT= \
                         FL_OVERRIDE=override
HIDE_UNDOC_RELATIONS   = YES
HAVE_DOT               = NO
